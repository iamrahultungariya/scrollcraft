{
  "name": "scrollcraft-monorepo",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "dev:clean": "pnpm --filter web clean && turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "vitest run",
    "test:bench": "vitest run --config vitest.bench.config.mts",
    "test:browser": "playwright test",
    "quality": "pnpm lint && pnpm test",
    "quality:launch": "pnpm quality && pnpm test:browser",
    "clean": "turbo clean"
  },
  "packageManager": "pnpm@9.12.0",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.9.0",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3",
    "vitest": "^5.0.0"
  }
}
