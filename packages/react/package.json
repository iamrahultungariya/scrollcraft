{
  "name": "@scrollcraft/react",
  "version": "0.2.0",
  "description": "React & Next.js-native scroll toolkit with zero-rerender state, asChild Slot composition, and Lenis normalization",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/__tests__",
    "!dist/**/*.test.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./parallax": {
      "types": "./dist/primitives/parallax.d.ts",
      "import": "./dist/primitives/parallax.js",
      "default": "./dist/primitives/parallax.js"
    },
    "./reveal": {
      "types": "./dist/primitives/reveal.d.ts",
      "import": "./dist/primitives/reveal.js",
      "default": "./dist/primitives/reveal.js"
    },
    "./pin": {
      "types": "./dist/primitives/pin.d.ts",
      "import": "./dist/primitives/pin.js",
      "default": "./dist/primitives/pin.js"
    },
    "./progress": {
      "types": "./dist/primitives/scroll-progress.d.ts",
      "import": "./dist/primitives/scroll-progress.js",
      "default": "./dist/primitives/scroll-progress.js"
    },
    "./transform": {
      "types": "./dist/primitives/scroll-transform.d.ts",
      "import": "./dist/primitives/scroll-transform.js",
      "default": "./dist/primitives/scroll-transform.js"
    },
    "./draw": {
      "types": "./dist/primitives/scroll-draw.d.ts",
      "import": "./dist/primitives/scroll-draw.js",
      "default": "./dist/primitives/scroll-draw.js"
    },
    "./marquee": {
      "types": "./dist/components/velocity-marquee.d.ts",
      "import": "./dist/components/velocity-marquee.js",
      "default": "./dist/components/velocity-marquee.js"
    },
    "./inspector": {
      "types": "./dist/components/scroll-inspector.d.ts",
      "import": "./dist/components/scroll-inspector.js",
      "default": "./dist/components/scroll-inspector.js"
    },
    "./text-reveal": {
      "types": "./dist/components/text-reveal.d.ts",
      "import": "./dist/components/text-reveal.js",
      "default": "./dist/components/text-reveal.js"
    },
    "./stacked-cards": {
      "types": "./dist/components/stacked-cards.d.ts",
      "import": "./dist/components/stacked-cards.js",
      "default": "./dist/components/stacked-cards.js"
    },
    "./sequence": {
      "types": "./dist/components/scroll-sequence.d.ts",
      "import": "./dist/components/scroll-sequence.js",
      "default": "./dist/components/scroll-sequence.js"
    },
    "./direction": {
      "types": "./dist/hooks/useScrollDirection.d.ts",
      "import": "./dist/hooks/useScrollDirection.js",
      "default": "./dist/hooks/useScrollDirection.js"
    },
    "./magnetic": {
      "types": "./dist/components/magnetic.d.ts",
      "import": "./dist/components/magnetic.js",
      "default": "./dist/components/magnetic.js"
    },
    "./horizontal": {
      "types": "./dist/components/horizontal-scroll.d.ts",
      "import": "./dist/components/horizontal-scroll.js",
      "default": "./dist/components/horizontal-scroll.js"
    },
    "./skew-gallery": {
      "types": "./dist/components/skew-gallery.d.ts",
      "import": "./dist/components/skew-gallery.js",
      "default": "./dist/components/skew-gallery.js"
    }
  },
  "scripts": {
    "clean": "node -e \"const fs = require('fs'); fs.rmSync('dist', { recursive: true, force: true });\"",
    "prebuild": "pnpm run clean",
    "build": "tsc",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@scrollcraft/core": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.3"
  }
}
